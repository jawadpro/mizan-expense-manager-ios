# Only DATABASE_URL is required. Deploy, open the app, and the setup page asks for everything else
# (admin account, banks, your name) and creates the signing secret, SMS token and notification keys.
# Any value below that you set in the environment wins over the one the setup page saved.

# Postgres (Neon recommended), with sslmode=require. Use the direct connection string, not the "-pooler" one:
# Mizan keeps each account's identity on its own database session, which a transaction pooler would mix up.
# (A Neon "-pooler" address is switched to the direct one automatically.)
DATABASE_URL=

# --- Account emails (confirm address, reset password) via https://resend.com ---
RESEND_API_KEY=
# e.g. Mizan <hello@yourdomain.com>, on a domain you verified in Resend.
EMAIL_FROM=
# Public address for links in emails, e.g. https://mizan.example.com (defaults to the request's address).
APP_URL=

# --- Optional overrides (leave empty to let the setup page handle them) ---
# Only for installs from before accounts: the old passphrase hash, used once to create the admin account.
ADMIN_PASSWORD_HASH=
# 32+ random characters. Signs session cookies, CSRF tokens and SMS fingerprints.
SESSION_SECRET=
# 32+ random characters. Bearer token the iPhone Shortcut sends to POST /api/sms.
SMS_INGEST_TOKEN=
# Set to "false" to send every parsed SMS to the review inbox.
SMS_AUTO_IMPORT=true
# Extra comma-separated sender IDs to trust, as if they were your first bank.
SMS_TRUSTED_SENDERS=
# Your name as the bank prints it (also editable in Settings).
SMS_OWN_NAMES=
# Web push keys for review notifications: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- iPhone pairing (see docs/iphone-shortcut.md) ---
# iCloud link of the universal Mizan Shortcut you built once, e.g. https://www.icloud.com/shortcuts/abc123...
MIZAN_SHORTCUT_URL=
# Its name on the iPhone, which the "Connect this iPhone" button opens. Default: Mizan
MIZAN_SHORTCUT_NAME=

# --- Optional: nightly backups to Google Drive ---
# 32+ random characters. Vercel Cron sends it to /api/cron/backup.
CRON_SECRET=
# Google OAuth client for Drive backups (drive.file scope).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: Pro subscriptions through Paddle ---
# "sandbox" or "production"
PADDLE_ENV=sandbox
# Developer tools > Authentication: a client-side token and a server API key.
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
# Developer tools > Notifications: destination https://your-app/api/billing/webhook, subscription.* events.
PADDLE_WEBHOOK_SECRET=
# Price ids (pri_...) of the monthly and yearly Pro prices. The free trial is set on the prices.
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=
# What the plans page shows.
PRICE_MONTHLY_LABEL=$4.99
PRICE_YEARLY_LABEL=$49
TRIAL_DAYS=14
